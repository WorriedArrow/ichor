   "link": null,
   "locked": false,
   "text": "Trust: only frame (and services/rt for native services) may use unsafe; lint enforces it and counts their lines and unsafe sites against a budget.\nEverything above frame is safe Rust: a bug there cannot corrupt memory, though a logic bug (a wrong capability check, say) can still be a hole.",
   "originalText": "Trust: only frame (and services/rt for native services) may use unsafe; lint enforces it and counts their lines and unsafe sites against a budget.\nEverything above frame is safe Rust: a bug there cannot corrupt memory, though a logic bug (a wrong capability check, say) can still be a hole.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  }
